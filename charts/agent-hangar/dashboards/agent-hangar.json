{
 "title": "Agent Hangar",
 "uid": "agent-hangar",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "refresh": "1m",
 "tags": [
  "agent-hangar"
 ],
 "templating": {
  "list": [
   {
    "name": "datasource",
    "type": "datasource",
    "query": "prometheus",
    "label": "Prometheus"
   },
   {
    "name": "namespace",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${datasource}"
    },
    "query": "label_values(hangar_build_info, namespace)",
    "includeAll": true,
    "multi": true,
    "current": {
     "text": "All",
     "value": "$__all"
    }
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Réplicas da central",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "count(hangar_build_info{namespace=~\"$namespace\"})",
     "refId": "A"
    }
   ]
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Chamadas a agentes (24 h)",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(increase(hangar_agent_invocations_total{namespace=~\"$namespace\"}[24h]))",
     "refId": "A"
    }
   ]
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Taxa de erro dos agentes (1 h)",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "decimals": 1
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(rate(hangar_agent_invocations_total{namespace=~\"$namespace\",ok=\"false\"}[1h])) / clamp_min(sum(rate(hangar_agent_invocations_total{namespace=~\"$namespace\"}[1h])), 1e-9)",
     "refId": "A"
    }
   ]
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Custo de LLM (24 h)",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD",
     "decimals": 2
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(increase(hangar_llm_cost_usd_total{namespace=~\"$namespace\"}[24h]))",
     "refId": "A"
    }
   ]
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Tokens (24 h)",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(increase(hangar_llm_tokens_total{namespace=~\"$namespace\"}[24h]))",
     "refId": "A"
    }
   ]
  },
  {
   "id": 6,
   "type": "stat",
   "title": "p95 da API (5 min)",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 20,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "decimals": 2
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le) (rate(hangar_http_request_duration_seconds_bucket{namespace=~\"$namespace\",route!~\"/gw.*|/mcp\"}[5m])))",
     "refId": "A"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Chamadas por agente",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    }
   },
   "targets": [
    {
     "expr": "sum by (agent) (rate(hangar_agent_invocations_total{namespace=~\"$namespace\"}[5m]))",
     "legendFormat": "{{agent}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Latência p95 por agente",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    }
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le, agent) (rate(hangar_agent_invocation_duration_seconds_bucket{namespace=~\"$namespace\"}[5m])))",
     "legendFormat": "{{agent}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Custo por agente (USD/h)",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    }
   },
   "targets": [
    {
     "expr": "sum by (agent) (rate(hangar_llm_cost_usd_total{namespace=~\"$namespace\"}[1h])) * 3600",
     "legendFormat": "{{agent}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Tokens por agente",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    }
   },
   "targets": [
    {
     "expr": "sum by (agent, direction) (rate(hangar_llm_tokens_total{namespace=~\"$namespace\"}[5m]))",
     "legendFormat": "{{agent}} {{direction}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Requisições HTTP por status",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    }
   },
   "targets": [
    {
     "expr": "sum by (status) (rate(hangar_http_requests_total{namespace=~\"$namespace\"}[5m]))",
     "legendFormat": "{{status}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "Jobs de harness finalizados",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 12,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    }
   },
   "targets": [
    {
     "expr": "sum by (status) (increase(hangar_jobs_finished_total{namespace=~\"$namespace\"}[15m]))",
     "legendFormat": "{{status}}",
     "refId": "A"
    }
   ]
  }
 ]
}
