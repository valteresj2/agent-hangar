# Gerado por ./setup.sh (ou setup.ps1). Não versionar o .env.
# Agent Hangar visto de dentro do container do LibreChat
HANGAR_BASE_URL=http://host.docker.internal:8090
# Chave de consumo do agente (escopo invoke): hangar keys create librechat --scope invoke --agent data-studio
HANGAR_INVOKE_KEY=

# Segredos do LibreChat (hex aleatório)
CREDS_KEY=
CREDS_IV=
JWT_SECRET=
JWT_REFRESH_SECRET=

ALLOW_REGISTRATION=true
LIBRECHAT_PORT=3090
LIBRECHAT_URL=http://localhost:3090
