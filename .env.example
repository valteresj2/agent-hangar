# Agent Hangar — copie para .env e preencha, ou rode scripts/setup.sh (scripts/setup.ps1 no Windows),
# que gera todos os segredos abaixo automaticamente.

# Credencial de bootstrap e emergência (poder total). Com o SSO configurado, guarde-a num cofre; no dia a dia
# cada pessoa entra com a conta da empresa e usa o próprio token pessoal (Chaves de API → user).
ADMIN_TOKEN=
# Chave Fernet que criptografa as api keys das conexões de LLM no banco. NÃO a perca: sem ela as chaves
# salvas não podem ser lidas. Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
HANGAR_SECRET_KEY=
# Segredo HMAC dos tokens internos por agente (agente -> hangar).
INTERNAL_SECRET=
POSTGRES_PASSWORD=

# Login corporativo (OAuth2). Também dá para configurar tudo na UI (SSO e SCIM), que tem prioridade.
# Redirect URI a cadastrar no provedor: <PUBLIC_BASE_URL>/api/auth/callback/<google|microsoft|github|oauth2>
# E-mails que viram admin da plataforma no primeiro login (vírgula):
# BOOTSTRAP_ADMIN_EMAILS=voce@empresa.com
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_GOOGLE_ALLOWED_DOMAINS=empresa.com
# OAUTH_MICROSOFT_CLIENT_ID=
# OAUTH_MICROSOFT_CLIENT_SECRET=
# OAUTH_MICROSOFT_TENANT=empresa.onmicrosoft.com     # ID ou domínio do tenant (nunca "common")
# OAUTH_MICROSOFT_FETCH_GROUPS=1                     # grupos -> times (GroupMember.Read.All, consentimento de admin)
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=
# OAUTH_GITHUB_ORGS=sua-org                          # exige ser membro da organização
# LOCAL_LOGIN=0                                      # desliga contas locais (usuário e senha); padrão: ligado
# SESSION_TTL_HOURS=12

# Catálogo Docker MCP (docker compose --profile mcp-gateway up -d) — ver docs/mcp-catalog.md
# MCP_GATEWAY_VERSION=v0.43.3
# MCP_GATEWAY_CATALOG_URL=https://desktop.docker.com/mcp/catalog/v2/catalog.yaml

# Agendamentos: o fuso padrão fica na empresa (PATCH /api/org {"timezone": "America/Sao_Paulo"}).
# SCHEDULER_ENABLED=1                                # 0 desliga o agendador (ex.: numa réplica só de API)
# SCHEDULE_MIN_INTERVAL_MIN=5                        # menor intervalo entre disparos
# SCHEDULE_ALLOW_PRIVATE_WEBHOOKS=0                  # 1 libera webhooks para a rede interna
# COOKIE_SECURE=1                                    # padrão: 1 quando PUBLIC_BASE_URL é https

# URL pela qual clientes (Claude, LibreChat, …) alcançam o hangar.
PUBLIC_BASE_URL=http://localhost:8090
CENTRAL_PORT=8090

# Imagens: padrão = builds locais. Para usar as imagens publicadas:
# HANGAR_REGISTRY=ghcr.io/<owner>
# HANGAR_VERSION=0.1.0

# Usado só quando um agente não tem nenhuma conexão de LLM associada (mock = sem custo, sem chave).
DEFAULT_MODEL=mock/echo
JOB_TIMEOUT_S=180

# Migração de uma instalação "central-agents" (pré-0.1.0): reaproveite o volume e o usuário do Postgres.
# PGDATA_VOLUME=central-agents_pgdata
# POSTGRES_USER=central
# POSTGRES_DB=central

# Nenhum LLM roda em Docker aqui. Registre conexões (url + model_name + api key virtual — ex.: seu gateway
# LiteLLM, OpenRouter, OpenAI, Anthropic) pela UI (Provedores) ou via MCP (register_llm_connection).

# Data Studio (docker compose --profile data-studio): links de download precisam abrir no navegador dos usuários
# DATA_STUDIO_PUBLIC_URL=http://localhost:8095
# DATA_STUDIO_PORT=8095
# DATA_STUDIO_MEM=4g
